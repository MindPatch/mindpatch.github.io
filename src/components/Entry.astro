---
import { formatDot, readingTime, type Post } from '../lib/posts';
interface Props { post: Post }
const { post } = Astro.props;
const { data } = post;
---
<li class="entry">
  <a href={`/blog/${post.id}/`}>
    <time datetime={data.pubDate.toISOString()}>{formatDot(data.pubDate)}</time>
    <div>
      <h3>{data.title}</h3>
      <p>{data.description}</p>
    </div>
    <span class="rt">{readingTime(post.body)} min</span>
  </a>
</li>
