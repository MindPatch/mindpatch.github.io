---
const path = Astro.url.pathname;
const on = (p: string) => (p === '/' ? path === '/' : path.startsWith(p)) ? 'page' : undefined;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/"><img src="/images/avatar.jpg" alt="" width="28" height="28" />MindPatch</a>
    <nav class="nav" aria-label="Main">
      <a href="/" aria-current={on('/')}>Home</a>
      <a href="/blog/" aria-current={on('/blog')}>Writing</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</header>
