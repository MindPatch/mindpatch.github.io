---
const path = Astro.url.pathname;
const home = path === '/';
const writing = path.startsWith('/blog');
---
<header class="site-head">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="MindPatch home"><i></i>MindPatch</a>
    <nav aria-label="Main">
      <a href="/" aria-current={home ? 'page' : undefined}>Index</a>
      <a href="/blog/" aria-current={writing ? 'page' : undefined}>Writing</a>
      <a class="hide" href="/#about">About</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</header>
