---
import Base from '../layouts/Base.astro';
---
<Base title="404 — MindPatch" description="Page not found." noindex>
  <section class="hero page lost">
    <div class="lbl rise d1"><b class="off"></b>Error · 404</div>
    <h1 class="rise d2"><span class="l"><span class="o">Nothing</span></span><span class="l">lives <span class="y">here.</span></span></h1>
    <p class="bio rise d3">This address doesn't resolve to anything. It may have moved, or the link is wrong.</p>
    <div class="actions rise d4">
      <a class="btn" href="/">Back to the index <span>→</span></a>
      <a class="btn ghost" href="/blog/">All writing <span>→</span></a>
    </div>
  </section>
</Base>
