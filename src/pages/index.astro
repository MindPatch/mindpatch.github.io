---
import Base from '../layouts/Base.astro';
import Shell from '../components/Shell.astro';
import { SITE } from '../consts';
import { getPosts, formatDate } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 5);

const person = {
  '@type': 'Person',
  name: SITE.author,
  alternateName: 'MindPatch',
  jobTitle: 'Security Engineer',
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  sameAs: SITE.sameAs,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.blogTitle,
  description: SITE.blogDescription,
  url: SITE.url,
  author: person,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, SITE.url).href,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---
<Base title={SITE.title} description={SITE.blogDescription} jsonLd={jsonLd}>
  <Shell>
    <section id="writing" class="block">
      <h2 class="block-label">Latest writing</h2>
      {posts.length === 0 && <p class="empty">Nothing here yet.</p>}
      <ul class="cards">
        {latest.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
              <span class="title">{p.data.title}</span>
              <p class="desc">{p.data.description}</p>
              {p.data.tags.length > 0 && <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>}
            </a>
          </li>
        ))}
      </ul>
      <a class="more" href="/blog/">All writing →</a>
    </section>
  </Shell>
</Base>
