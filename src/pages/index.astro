---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { getPosts, formatDate } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 3);

const elsewhere = [
  { label: 'github', href: 'https://github.com/MindPatch', handle: 'MindPatch' },
  { label: 'medium', href: 'https://mindpatch.medium.com/', handle: 'mindpatch' },
  { label: 'twitter', href: 'https://twitter.com/mindpatchsec', handle: SITE.twitter },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/knassar702/', handle: 'knassar702' },
  { label: 'email', href: `mailto:${SITE.email}`, handle: SITE.email },
];

const person = {
  '@type': 'Person',
  name: SITE.author,
  alternateName: 'MindPatch',
  jobTitle: 'Security Engineer',
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  sameAs: SITE.sameAs,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.blogTitle,
  description: SITE.blogDescription,
  url: SITE.url,
  author: person,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, SITE.url).href,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---
<Base title={SITE.title} description={SITE.blogDescription} jsonLd={jsonLd}>
  <Header />
  <main class="wrap">
    <header class="page-head with-avatar">
      <img class="avatar" src="/images/avatar.jpg" alt="" width="64" height="64" />
      <div>
        <h1>{SITE.author}</h1>
        <p>Security engineer. Notes from vulnerability research, malware analysis and whatever I'm building.</p>
      </div>
    </header>

    <section class="section">
      <div class="section-head">
        <h2 class="section-label">Latest writing</h2>
        <span class="links"><a href="/blog/">all {posts.length} →</a><a href="/rss.xml">rss</a></span>
      </div>
      {latest.length === 0 && <p class="empty">Nothing here yet.</p>}
      <ul class="entries">
        {latest.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
              <span class="title">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section">
      <div class="section-head"><h2 class="section-label">Elsewhere</h2></div>
      <ul class="rows">
        {elsewhere.map((l) => (
          <li><span class="label">{l.label}</span><a href={l.href} rel={l.label === 'email' ? undefined : 'me noopener'}>{l.handle}</a></li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Base>
