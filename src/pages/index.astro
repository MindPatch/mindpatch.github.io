---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import Featured from '../components/Featured.astro';
import { SITE } from '../consts';
import { getPosts, formatDot, pad } from '../lib/posts';

const posts = await getPosts();
const [featured, ...rest] = posts;
const more = rest.slice(0, 5);
const { hero } = SITE;
const [first, ...last] = SITE.author.split(' ');
const facts = [
  ...hero.facts,
  { k: 'Write-ups', v: pad(posts.length) },
  ...(featured ? [{ k: 'Last post', v: formatDot(featured.data.pubDate) }] : []),
];

const person = {
  '@type': 'Person',
  name: SITE.author,
  alternateName: 'MindPatch',
  jobTitle: 'Security Engineer',
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  sameAs: SITE.sameAs,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.blogTitle,
  description: SITE.blogDescription,
  url: SITE.url,
  author: person,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, SITE.url).href,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---
<Base title={SITE.title} description={SITE.blogDescription} jsonLd={jsonLd}>
  <section class="hero home" id="about">
    <div>
      <div class="lbl">{hero.label}</div>
      <h1><span class="l">{first}</span> <span class="l">{last.join(' ')}</span></h1>
      <p class="bio">{hero.bio}</p>
      <ul class="find" aria-label="Elsewhere">
        {SITE.links.map((l) => (
          <li><a href={l.href} rel={l.label === 'email' ? undefined : 'me noopener'}>{l.name}</a></li>
        ))}
      </ul>
    </div>
    <aside class="id" aria-label="About">
      <img src="/images/avatar.jpg" alt="" width="256" height="256" />
      <dl>{facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}</dl>
    </aside>
  </section>

  {featured ? <Featured post={featured} /> : <p class="empty">Nothing here yet.</p>}

  {more.length > 0 && (
    <section id="writing">
      <div class="sh"><h2>More writing</h2><a class="lbl" href="/blog/">All posts →</a></div>
      <ul class="entries">{more.map((p) => <Entry post={p} />)}</ul>
    </section>
  )}
</Base>
