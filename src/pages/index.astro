---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostMeta from '../components/PostMeta.astro';
import { SITE } from '../consts';
import { getPosts, readingTime } from '../lib/posts';

const latest = (await getPosts()).slice(0, 3);
const links = [
  { label: 'GitHub', href: 'https://github.com/MindPatch' },
  { label: 'Medium', href: 'https://mindpatch.medium.com/' },
  { label: 'Twitter', href: 'https://twitter.com/mindpatchsec' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/knassar702/' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  alternateName: 'MindPatch',
  jobTitle: 'Security Engineer',
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  sameAs: SITE.sameAs,
};
---
<Base title={SITE.title} description={SITE.description} bodyClass="blog" jsonLd={jsonLd}>
  <Header />
  <main class="wrap">
    <section class="hero">
      <button type="button" class="sprite" id="sprite" aria-label="Change avatar colours">
        <!-- original 16x16 pixel robot: rounded helmet, wide visor, LED strip, jacket -->
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <g id="helmet" fill="#C9CED8"><path d="M5 1h6v1H5zM4 2h8v1H4zM3 3h10v8H3zM4 11h8v1H4z"/></g>
          <path fill="#8A94A6" d="M3 3h1v8H3zM12 3h1v8h-1zM4 11h8v1H4z" opacity=".6"/>
          <path fill="#0B0E14" d="M4 5h8v4H4z"/>
          <g id="visor" fill="#FF5D3A"><path d="M5 6h6v2H5z"/></g>
          <path fill="#E8F0E0" d="M5 6h1v1H5z" opacity=".8"/>
          <g id="led" fill="#5CFF7A"><path d="M6 10h1v1H6zM8 10h1v1H8zM10 10h1v1h-1z"/></g>
          <g id="jacket" fill="#1A1A1A"><path d="M4 12h8v3H4zM3 13h1v2H3zM12 13h1v2h-1z"/></g>
          <path fill="#C9CED8" d="M7 12h2v3H7z" opacity=".9"/>
        </svg>
      </button>
      <div>
        <p class="hi">Hi, I'm</p>
        <h1>Khaled Nassar <span>aka MindPatch</span></h1>
        <p class="prompt cursor" id="role" aria-live="polite">SECURITY ENGINEER</p>
        <p class="bio">
          I hunt bugs, dig into vulnerabilities, play CTFs and write Rust.
          The blog is where I write up what I find.
        </p>
        <div class="actions">
          <a class="btn primary" href="/blog/">Read the blog</a>
          <a class="btn" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
        <ul class="social" aria-label="Elsewhere">
          {links.map((l) => <li><a href={l.href} rel="me noopener">{l.label}</a></li>)}
        </ul>
      </div>
    </section>

    {latest.length > 0 && (
      <section class="latest" aria-labelledby="latest-title">
        <div class="section-head">
          <h2 id="latest-title">Latest posts</h2>
          <a class="more" href="/blog/">All posts &gt;</a>
        </div>
        <ul class="posts">
          {latest.map((p) => (
            <li>
              <a class="card" href={`/blog/${p.id}/`}>
                <PostMeta pubDate={p.data.pubDate} minutes={readingTime(p.body)} />
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .hero { display: grid; grid-template-columns: auto 1fr; gap: 40px; align-items: start; padding: 24px 0 56px; }
  .sprite {
    display: block; width: 136px; height: 136px; padding: 16px; border: 0; cursor: pointer;
    background: var(--panel); box-shadow: 0 0 0 4px var(--line), 0 0 0 8px var(--bg), 0 0 0 12px var(--accent);
    margin: 12px;
  }
  .sprite svg { width: 100%; height: 100%; shape-rendering: crispEdges; }
  .sprite:active { transform: translateY(3px); }
  .hi { margin: 0; color: var(--dim); font-family: var(--mono); font-size: 15px; }
  h1 { font-family: var(--display); font-size: clamp(38px, 7vw, 60px); font-weight: 700; line-height: 1.05; letter-spacing: -.03em; margin: 6px 0 14px; text-shadow: 4px 4px 0 #2A1F3D; }
  h1 span { display: block; color: var(--accent); font-size: .55em; letter-spacing: -.01em; margin-top: 8px; text-shadow: none; }
  #role { min-height: 1.8em; margin: 0 0 18px; }
  .bio { margin: 0 0 28px; color: #C7D0C0; max-width: 34em; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 24px; }
  .btn { font-family: var(--display); font-weight: 600; font-size: 16px; padding: 10px 18px; box-shadow: 0 0 0 3px var(--line); transition: transform .1s steps(2), box-shadow .1s steps(2); }
  .btn:hover { color: var(--yellow); box-shadow: 0 0 0 3px var(--yellow); transform: translate(-2px, -2px); }
  .btn.primary { background: var(--accent); color: var(--bg); box-shadow: 4px 4px 0 #2A1F3D; }
  .btn.primary:hover { background: var(--yellow); color: var(--bg); box-shadow: 6px 6px 0 #2A1F3D; }
  .social { display: flex; flex-wrap: wrap; gap: 8px 22px; list-style: none; margin: 0; padding: 0; font-family: var(--mono); font-size: 14px; }
  .social a { color: var(--dim); }
  .social a::before { content: "> "; color: var(--accent); }
  .social a:hover { color: var(--yellow); }

  .latest { padding-top: 40px; border-top: 4px dashed var(--line); }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .section-head h2 { font-family: var(--display); font-size: 26px; font-weight: 700; margin: 0; }
  .section-head h2::before { content: "## "; color: var(--accent); font-family: var(--mono); font-size: .75em; font-weight: 400; }
  .more { font-family: var(--mono); font-size: 14px; color: var(--green); }
  .card h3 { font-family: var(--display); font-size: 22px; font-weight: 700; line-height: 1.3; margin: 6px 0 8px; }
  .card:hover h3 { color: var(--yellow); }

  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; gap: 24px; padding-top: 8px; }
    .sprite { width: 104px; height: 104px; padding: 12px; }
  }
</style>

<script is:inline>
(function () {
  // role cycles every few seconds, typed out character by character; clicking the robot skips ahead
  var roles = ['SECURITY ENGINEER', 'BUG HUNTER', 'VULN RESEARCHER', 'RUST ENJOYER', 'CVE COLLECTOR', 'CTF PLAYER'],
      // [helmet, visor, led] per role
      pal = [['#C9CED8','#FF5D3A','#5CFF7A'],['#FFD23F','#1A1A1A','#FF5D3A'],['#2C3546','#4DA3FF','#4DA3FF'],['#B05A3C','#FFD23F','#FFD23F'],['#9B5DE5','#5CFF7A','#E8F0E0'],['#E8F0E0','#FF3FA0','#FF3FA0']],
      role = document.getElementById('role'), r = 0, timer, typing;
  function show(i) {
    r = i % roles.length;
    document.getElementById('helmet').setAttribute('fill', pal[r][0]);
    document.getElementById('visor').setAttribute('fill', pal[r][1]);
    document.getElementById('led').setAttribute('fill', pal[r][2]);
    clearTimeout(typing);
    var s = roles[r], k = 0; role.textContent = '';
    (function type() { if (k <= s.length) { role.textContent = s.slice(0, k++); typing = setTimeout(type, 45); } })();
    clearTimeout(timer); timer = setTimeout(function () { show(r + 1); }, 3200);
  }
  show(0);
  document.getElementById('sprite').onclick = function () { show(r + 1); };
})();
</script>
