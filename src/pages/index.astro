---
import Base from '../layouts/Base.astro';
import Sprite from '../components/Sprite.astro';
import { SITE } from '../consts';
import { getPosts, formatDate } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 3);

// Stroke icons (24x24) for the link rows.
const icons = {
  writings: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6M10 17h6"/>',
  post: '<path d="M4 6h16M4 12h16M4 18h10"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  medium: '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  twitter: '<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  email: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
};

const elsewhere = [
  { label: 'GitHub', href: 'https://github.com/MindPatch', handle: '@MindPatch', icon: icons.github },
  { label: 'Medium', href: 'https://mindpatch.medium.com/', handle: '@mindpatch', icon: icons.medium },
  { label: 'Twitter', href: 'https://twitter.com/mindpatchsec', handle: SITE.twitter, icon: icons.twitter },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/knassar702/', handle: 'knassar702', icon: icons.linkedin },
];

const person = {
  '@type': 'Person',
  name: SITE.author,
  alternateName: 'MindPatch',
  jobTitle: 'Security Engineer',
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  sameAs: SITE.sameAs,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.blogTitle,
  description: SITE.blogDescription,
  url: SITE.url,
  author: person,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, SITE.url).href,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---
<Base title={SITE.title} description={SITE.blogDescription} jsonLd={jsonLd}>
  <main class="page">
    <section class="intro">
      <div class="avatar"><Sprite size={56} /></div>
      <h1 class="name">{SITE.author}</h1>
    </section>

    <section class="about">
      <p>Security engineer. Notes from vulnerability research, malware analysis and whatever I'm building.</p>
    </section>

    <section class="group">
      <h2 class="glabel">Archive</h2>
      <a class="row" href="/blog/">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.writings} />
        <span class="lbl">Writings</span><span class="meta-r">{posts.length}</span>
      </a>
      <a class="row" href="/rss.xml">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.rss} />
        <span class="lbl">RSS feed</span><span class="meta-r">/rss.xml</span>
      </a>
    </section>

    {latest.length > 0 && (
      <section class="group">
        <h2 class="glabel">Latest</h2>
        {latest.map((p) => (
          <a class="row" href={`/blog/${p.id}/`}>
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.post} />
            <span class="lbl">{p.data.title}</span>
            <time class="meta-r" datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
          </a>
        ))}
      </section>
    )}

    <section class="group">
      <h2 class="glabel">Elsewhere</h2>
      {elsewhere.map((l) => (
        <a class="row" href={l.href} rel="me noopener" target="_blank">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
          <span class="lbl">{l.label}</span><span class="meta-r">{l.handle}</span>
        </a>
      ))}
      <a class="row" href={`mailto:${SITE.email}`}>
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.email} />
        <span class="lbl">Email</span><span class="meta-r">{SITE.email}</span>
      </a>
    </section>

    <p class="foot">© {new Date().getFullYear()} {SITE.author}</p>
  </main>
</Base>

<style>
  .page {
    width: 100%; max-width: 460px; margin: 0 auto;
    min-height: 100dvh; display: flex; flex-direction: column; justify-content: center;
    gap: 1.8rem; padding: 3rem 1.5rem;
  }
  .intro { text-align: center; }
  .avatar {
    width: 92px; height: 92px; margin: 0 auto; border-radius: 50%;
    display: grid; place-items: center; background: var(--bg-soft);
    border: 1px solid var(--border); box-shadow: 0 8px 24px -12px rgba(0, 0, 0, .8);
  }
  .name { margin: 1rem 0 0; font-size: 1.8rem; font-weight: 700; letter-spacing: -.02em; }

  .about { border: 1px solid var(--border); border-radius: 12px; padding: 1.1rem 1.3rem; background: var(--bg-soft); }
  .about p { margin: 0; color: var(--fg); font-size: .95rem; line-height: 1.7; }

  .group { display: flex; flex-direction: column; gap: .5rem; }
  .glabel { margin: 0 0 .1rem; font-size: .72rem; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; color: var(--fg-muted); }
  .row {
    display: flex; align-items: center; gap: .8rem;
    padding: .72rem .9rem; border: 1px solid var(--border); border-radius: 10px;
    background: var(--bg-soft); color: var(--fg); font-size: .95rem; line-height: 1.45;
    transition: border-color .15s ease, background .15s ease;
  }
  .row:hover { background: var(--bg-hover); border-color: color-mix(in oklab, var(--accent) 40%, var(--border)); color: var(--fg); }
  .ic { width: 20px; height: 20px; flex-shrink: 0; color: var(--accent); }
  .lbl { flex: 1; min-width: 0; font-weight: 500; }
  .meta-r { color: var(--fg-muted); font-size: .85rem; font-family: var(--mono); white-space: nowrap; }

  .foot { text-align: center; margin: .4rem 0 0; color: var(--fg-muted); font-size: .8rem; font-family: var(--mono); }

  @media (max-width: 420px) {
    .name { font-size: 1.6rem; }
    .meta-r { font-size: .78rem; }
  }
</style>
