---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { getPosts, formatDate } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 5);

const elsewhere = [
  { label: 'github', href: 'https://github.com/MindPatch', handle: 'MindPatch' },
  { label: 'medium', href: 'https://mindpatch.medium.com/', handle: 'mindpatch' },
  { label: 'twitter', href: 'https://twitter.com/mindpatchsec', handle: SITE.twitter },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/knassar702/', handle: 'knassar702' },
  { label: 'email', href: `mailto:${SITE.email}`, handle: SITE.email },
];

const person = {
  '@type': 'Person',
  name: SITE.author,
  alternateName: 'MindPatch',
  jobTitle: 'Security Engineer',
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  sameAs: SITE.sameAs,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.blogTitle,
  description: SITE.blogDescription,
  url: SITE.url,
  author: person,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, SITE.url).href,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---
<Base title={SITE.title} description={SITE.blogDescription} jsonLd={jsonLd}>
  <div class="split">
    <aside class="split-side">
      <div class="side-inner">
        <img class="portrait" src="/images/avatar.jpg" alt="" width="96" height="96" />
        <h1 class="side-name">{SITE.author}</h1>
        <p class="side-role">Security engineer</p>
        <p class="side-intro">Notes from vulnerability research, malware analysis and whatever I'm building.</p>
        <nav class="side-nav" aria-label="Sections">
          <a href="#writing" aria-current="page">Latest</a>
          <a href="/blog/">Archive</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <ul class="side-links">
          {elsewhere.map((l) => (
            <li><a href={l.href} rel={l.label === 'email' ? undefined : 'me noopener'}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </aside>

    <main class="split-main">
      <section id="writing" class="block">
        <h2 class="block-label">Latest writing</h2>
        {posts.length === 0 && <p class="empty">Nothing here yet.</p>}
        <ul class="cards">
          {latest.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`}>
                <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
                <span class="title">{p.data.title}</span>
                <p class="desc">{p.data.description}</p>
                {p.data.tags.length > 0 && <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>}
              </a>
            </li>
          ))}
        </ul>
        <a class="more" href="/blog/">All writing →</a>
      </section>

      <footer class="split-foot">© {new Date().getFullYear()} {SITE.author}</footer>
    </main>
  </div>
</Base>
