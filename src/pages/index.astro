---
import Base from '../layouts/Base.astro';
import Shell from '../components/Shell.astro';
import { SITE } from '../consts';
import { getPosts, formatDate, category, readingTime } from '../lib/posts';
import Thumb from '../components/Thumb.astro';

const posts = await getPosts();
const latest = posts.slice(0, 5);

const person = {
  '@type': 'Person',
  name: SITE.author,
  alternateName: 'MindPatch',
  jobTitle: 'Security Engineer',
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  sameAs: SITE.sameAs,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.blogTitle,
  description: SITE.blogDescription,
  url: SITE.url,
  author: person,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, SITE.url).href,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---
<Base title={SITE.title} description={SITE.blogDescription} jsonLd={jsonLd}>
  <Shell>
    <section class="intro">
      <img class="portrait" src="/images/avatar.jpg" alt="" width="72" height="72" />
      <h1>{SITE.author}</h1>
      <p class="intro-role">{SITE.role}. {SITE.tagline}</p>
      <ul class="intro-links" aria-label="Elsewhere">
        {SITE.links.map((l) => (
          <li><a href={l.href} rel={l.label === 'email' ? undefined : 'me noopener'}>{l.name}</a></li>
        ))}
      </ul>
    </section>
    <section id="writing" class="block">
      <h2 class="block-label">Latest writing</h2>
      {posts.length === 0 && <p class="empty">Nothing here yet.</p>}
      <ul class="cards">
        {latest.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`} class="has-thumb">
              <span class="card-body">
                <span class="card-meta"><time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>{category(p) && <span class="cat">{category(p)}</span>}<span class="mins">{readingTime(p.body)} min</span></span>
                <span class="title">{p.data.title}</span>
                <p class="desc">{p.data.description}</p>
                {p.data.tags.length > 0 && <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>}
              </span>
              <Thumb post={p} />
            </a>
          </li>
        ))}
      </ul>
      <a class="more" href="/blog/">All writing <span aria-hidden="true">→</span></a>
    </section>
  </Shell>
</Base>
