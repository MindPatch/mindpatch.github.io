---
import Base from '../layouts/Base.astro';
import Sprite from '../components/Sprite.astro';
import { SITE } from '../consts';
import { getPosts, formatDate } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 3);

// Stroke icons (24x24) for the link rows.
const icons = {
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  medium: '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  twitter: '<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  email: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
};

const elsewhere = [
  { label: 'GitHub', href: 'https://github.com/MindPatch', handle: '@MindPatch', icon: icons.github },
  { label: 'Medium', href: 'https://mindpatch.medium.com/', handle: '@mindpatch', icon: icons.medium },
  { label: 'Twitter', href: 'https://twitter.com/mindpatchsec', handle: SITE.twitter, icon: icons.twitter },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/knassar702/', handle: 'knassar702', icon: icons.linkedin },
];

const person = {
  '@type': 'Person',
  name: SITE.author,
  alternateName: 'MindPatch',
  jobTitle: 'Security Engineer',
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  sameAs: SITE.sameAs,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.blogTitle,
  description: SITE.blogDescription,
  url: SITE.url,
  author: person,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, SITE.url).href,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---
<Base title={SITE.title} description={SITE.blogDescription} jsonLd={jsonLd}>
  <main class="page">
    <section class="intro">
      <div class="avatar"><Sprite size={44} /></div>
      <div>
        <h1 class="name">{SITE.author}</h1>
        <p class="about">Security engineer. Notes from vulnerability research, malware analysis and whatever I'm building.</p>
      </div>
    </section>

    <section>
      <div class="head">
        <h2 class="glabel">writing</h2>
        <span class="head-links"><a href="/blog/">all {posts.length} →</a><a href="/rss.xml">rss</a></span>
      </div>
      {latest.length === 0 && <p class="empty">Nothing here yet.</p>}
      <ul class="latest">
        {latest.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
              <span class="t">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <div class="head"><h2 class="glabel">elsewhere</h2></div>
      <div class="links">
        {elsewhere.map((l) => (
          <a class="tile" href={l.href} rel="me noopener" target="_blank">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
            <span class="lbl">{l.label}<small>{l.handle}</small></span>
          </a>
        ))}
        <a class="tile" href={`mailto:${SITE.email}`}>
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.email} />
          <span class="lbl">Email<small>{SITE.email}</small></span>
        </a>
      </div>
    </section>

    <p class="foot">© {new Date().getFullYear()} {SITE.author}</p>
  </main>
</Base>

<style>
  .page {
    width: 100%; max-width: 640px; margin: 0 auto;
    display: flex; flex-direction: column; gap: 3rem; padding: 5rem 1.5rem 3rem;
  }
  .intro { display: flex; align-items: center; gap: 1.25rem; }
  .avatar {
    width: 72px; height: 72px; flex-shrink: 0; border-radius: 16px;
    display: grid; place-items: center; background: var(--bg-soft);
    border: 1px solid var(--border); box-shadow: inset 0 -2px 0 var(--accent);
  }
  .name { margin: 0; font-size: 1.9rem; font-weight: 700; letter-spacing: -.025em; }
  .about { margin: .3rem 0 0; color: var(--fg-muted); font-size: .98rem; line-height: 1.6; }

  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: .6rem; }
  .glabel { margin: 0; font-family: var(--mono); font-size: .8rem; font-weight: 400; color: var(--fg-muted); }
  .glabel::before { content: '/ '; color: var(--accent); }
  .head-links { display: flex; gap: 1rem; font-family: var(--mono); font-size: .8rem; }
  .head-links a { color: var(--fg-muted); }
  .head-links a:hover { color: var(--accent); }

  .latest { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .latest li { border-bottom: 1px solid var(--border); }
  .latest a { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; align-items: baseline; padding: .85rem 0; color: var(--fg-strong); }
  .latest time { font-family: var(--mono); font-size: .8rem; color: var(--fg-muted); }
  .latest .t { font-weight: 500; transition: color .15s ease; }
  .latest a:hover .t { color: var(--accent); }
  .empty { color: var(--fg-muted); }

  .links { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: .6rem; }
  .tile {
    display: flex; align-items: center; gap: .75rem; padding: .75rem .9rem;
    border: 1px solid var(--border); border-radius: 10px; background: var(--bg-soft); color: var(--fg-strong);
    transition: border-color .15s ease, transform .15s ease;
  }
  .tile:hover { border-color: color-mix(in oklab, var(--accent) 55%, var(--border)); color: var(--fg-strong); transform: translateY(-1px); }
  .ic { width: 20px; height: 20px; flex-shrink: 0; color: var(--accent); }
  .lbl { display: flex; flex-direction: column; min-width: 0; font-weight: 500; font-size: .92rem; line-height: 1.35; }
  .lbl small { font-family: var(--mono); font-weight: 400; font-size: .74rem; color: var(--fg-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .foot { margin: 0; color: var(--fg-muted); font-size: .8rem; font-family: var(--mono); }

  @media (max-width: 480px) {
    .page { padding-top: 3rem; gap: 2.5rem; }
    .intro { align-items: flex-start; }
    .avatar { width: 60px; height: 60px; border-radius: 14px; }
    .name { font-size: 1.6rem; }
    .latest a { grid-template-columns: 1fr; gap: .15rem; }
  }
</style>
