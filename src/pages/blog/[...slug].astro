---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Trace from '../../components/Trace.astro';
import { SITE } from '../../consts';
import { getPosts, readingTime, category, formatDot, pad, slugTag, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], n: posts.length - i },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post; n: number }
const { post, newer, older, n } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingTime(post.body);
const url = new URL(`/blog/${post.id}/`, SITE.url).href;

// Social cards want a JPG/PNG around 1200px wide, not the inline webp.
const ogImage = data.cover
  ? (await getImage({ src: data.cover, width: 1200, format: 'jpg' })).src
  : SITE.ogImage;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  image: new URL(ogImage, SITE.url).href,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  keywords: data.tags.join(', ') || undefined,
  wordCount: post.body?.split(/\s+/).filter(Boolean).length,
  author: { '@type': 'Person', name: SITE.author, alternateName: 'MindPatch', url: SITE.url, sameAs: SITE.sameAs },
  publisher: { '@type': 'Person', name: SITE.author, url: SITE.url },
};
---
<Base
  title={`${data.title} — MindPatch`}
  description={data.description}
  type="article"
  image={ogImage}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  tags={data.tags}
  jsonLd={jsonLd}
  noindex={data.draft}
>
  <article class="post">
    <header class="post-head">
      <div class="lbl rise d1 crumbs"><a href="/blog/">← Writing</a><span>No. {pad(n)}</span>{category(post) && <span class="c">{category(post)}</span>}</div>
      <h1 class="rise d2">{data.title}</h1>
      <div class="meta rise d3">
        <time datetime={data.pubDate.toISOString()}>{formatDot(data.pubDate)}</time>
        <span>{minutes} min read</span>
        {data.updatedDate && <span>Updated <time datetime={data.updatedDate.toISOString()}>{formatDot(data.updatedDate)}</time></span>}
        {data.ships && <span class="ships">+ {data.ships}</span>}
      </div>
      {data.tags.length > 0 && <div class="tags rise d3">{data.tags.map((t) => <span>{slugTag(t)}</span>)}</div>}
      {data.chain.length > 0 && <div class="rise d4"><Trace post={post} layout="row" title="Attack chain" link={false} /></div>}
    </header>
    {data.cover && (
      <figure class="cover">
        <Image src={data.cover} alt={data.coverAlt ?? ''} loading="eager" fetchpriority="high" />
      </figure>
    )}
    <div class:list={['post-body', { 'no-toc': toc.length < 2 }]}>
      {toc.length >= 2 && (
        <nav class="toc" aria-label="On this page">
          <div class="lbl">On this page</div>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  {(newer || older) && (
    <nav class="pager" aria-label="More posts">
      {older ? <a class="prev" href={`/blog/${older.id}/`}><span class="lbl">← Older</span><b>{older.data.title}</b></a> : <span class="end lbl">First entry</span>}
      {newer ? <a class="next" href={`/blog/${newer.id}/`}><span class="lbl">Newer →</span><b>{newer.data.title}</b></a> : <span class="end lbl">Latest entry</span>}
    </nav>
  )}
</Base>

<script>
  import mediumZoom from 'medium-zoom';

  async function renderMermaid() {
    const blocks = document.querySelectorAll('pre.mermaid');
    if (!blocks.length) return;
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      flowchart: { useMaxWidth: false },
      sequence: { useMaxWidth: false },
      fontFamily: "'IBM Plex Mono', ui-monospace, monospace",
      themeVariables: {
        darkMode: true,
        fontSize: '14px',
        background: '#1b1b18',
        primaryColor: '#23231f',
        primaryBorderColor: '#4a483f',
        primaryTextColor: '#ece6d8',
        lineColor: '#a9a395',
        secondaryColor: '#23231f',
        tertiaryColor: '#1b1b18',
        mainBkg: '#23231f',
        nodeBorder: '#4a483f',
        clusterBkg: '#1b1b18',
        clusterBorder: '#34332d',
        titleColor: '#ece6d8',
        edgeLabelBackground: '#141412',
        actorBkg: '#23231f',
        actorBorder: '#4a483f',
        actorTextColor: '#ece6d8',
        actorLineColor: '#4a483f',
        signalColor: '#a9a395',
        signalTextColor: '#ece6d8',
        labelBoxBkgColor: '#23231f',
        labelBoxBorderColor: '#4a483f',
        labelTextColor: '#ece6d8',
        loopTextColor: '#a9a395',
        noteBkgColor: '#2a2716',
        noteTextColor: '#ece6d8',
        noteBorderColor: '#f2c94c',
        activationBkgColor: '#34332d',
        activationBorderColor: '#a9a395',
      },
    });
    await mermaid.run({ nodes: blocks });
  }

  renderMermaid().finally(() => {
    mediumZoom('.prose img, .cover img', { margin: 24, background: 'rgba(20, 20, 18, .96)' });
  });

  // Language label and copy button on every highlighted code block.
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code')) {
    const shell = document.createElement('div');
    shell.className = 'code';
    pre.replaceWith(shell);
    const bar = document.createElement('div');
    bar.className = 'code-h';
    const lang = document.createElement('span');
    lang.className = 'lbl';
    const name = pre.dataset.language;
    lang.textContent = name && name !== 'plaintext' ? name : 'text';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy';
    btn.textContent = 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Failed';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1600);
    });
    bar.append(lang, btn);
    shell.append(bar, pre);
  }

  // Mark the section being read in the contents rail.
  const toc = new Map<string, HTMLAnchorElement>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.toc a')) toc.set(decodeURIComponent(a.hash.slice(1)), a);
  const heads = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')].filter((h) => toc.has(h.id));
  if (heads.length) {
    let ticking = false;
    const mark = () => {
      ticking = false;
      let cur: HTMLElement | undefined;
      for (const h of heads) if (h.getBoundingClientRect().top < 140) cur = h;
      for (const a of toc.values()) a.removeAttribute('aria-current');
      if (cur) toc.get(cur.id)?.setAttribute('aria-current', 'true');
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(mark); } }, { passive: true });
    mark();
  }
</script>
