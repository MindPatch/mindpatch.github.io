---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Shell from '../../components/Shell.astro';
import PostMeta from '../../components/PostMeta.astro';
import { SITE } from '../../consts';
import { getPosts, readingTime, category, tldr, type Post } from '../../lib/posts';
import { coverPath, tldrPath, CARD_W, CARD_H } from '../../lib/cards';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
// Contents (collapsible above the post, a side rail on very wide screens): top-level sections, plus their subsections when
// a post has only a few top-level ones.
const h2 = headings.filter((h) => h.depth === 2);
const toc = headings.filter((h) => h.depth === 2 || (h2.length < 4 && h.depth === 3));
const url = new URL(`/blog/${post.id}/`, SITE.url).href;

// Social cards want a JPG/PNG around 1200px wide, not the inline webp.
// Without a cover, the generated title card is the social image.
const ogImage = data.cover
  ? (await getImage({ src: data.cover, width: 1200, format: 'jpg' })).src
  : coverPath(post);
const points = tldr(post);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  image: new URL(ogImage, SITE.url).href,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  keywords: data.tags.join(', ') || undefined,
  wordCount: post.body?.split(/\s+/).filter(Boolean).length,
  author: { '@type': 'Person', name: SITE.author, alternateName: 'MindPatch', url: SITE.url, sameAs: SITE.sameAs },
  publisher: { '@type': 'Person', name: SITE.author, url: SITE.url },
};
---
<Base
  title={`${data.title} — MindPatch`}
  description={data.description}
  type="article"
  image={ogImage}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  tags={data.tags}
  jsonLd={jsonLd}
  noindex={data.draft}
  bodyClass={h2.length >= 2 ? 'has-rail' : undefined}
>
  <Shell>
    <div class="progress" aria-hidden="true"><span></span></div>
    <div class="post-grid">
      <article>
        <header class="post-head">
          <a class="back" href="/blog/">← All writing</a>
          {category(post) && <p class="kicker">{category(post)}</p>}
          <h1>{data.title}</h1>
          <PostMeta pubDate={data.pubDate} updatedDate={data.updatedDate} minutes={readingTime(post.body)} />
          {data.tags.length > 0 && <ul class="tags">{data.tags.map((t) => <li>{t}</li>)}</ul>}
        </header>
        <figure class="cover" style={`view-transition-name: cover-${post.id}`}>
          {data.cover
            ? <Image src={data.cover} alt={data.coverAlt ?? ''} loading="eager" fetchpriority="high" />
            : <img src={coverPath(post)} alt="" width={CARD_W} height={CARD_H} loading="eager" fetchpriority="high" />}
        </figure>
        <aside class="tldr" aria-labelledby="tldr-label">
          <div class="tldr-head">
            <h2 id="tldr-label" class="tldr-label">TL;DR</h2>
            <a class="tldr-save" href={tldrPath(post)} download={`${post.id}-tldr.png`}>Save as image</a>
          </div>
          {points.length > 1
            ? <ul>{points.map((p) => <li>{p}</li>)}</ul>
            : <p>{points[0]}</p>}
        </aside>
        {h2.length >= 2 && (
          <details class="toc toc-inline">
            <summary>On this page</summary>
            <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        )}
        <div class="prose">
          <Content />
        </div>
      </article>
      {h2.length >= 2 && (
        <aside class="toc-rail">
          <nav class="toc" aria-label="On this page">
            <p class="toc-label">On this page</p>
            <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        </aside>
      )}
    </div>
    {(newer || older) && (
      <nav class="post-foot" aria-label="More posts">
        <div class="pager">
          {older && <a class="prev" href={`/blog/${older.id}/`}><small>← Older</small>{older.data.title}</a>}
          {newer && <a class="next" href={`/blog/${newer.id}/`}><small>Newer →</small>{newer.data.title}</a>}
        </div>
      </nav>
    )}
  </Shell>
</Base>

<script>
  import mediumZoom from 'medium-zoom';

  async function renderMermaid() {
    const blocks = document.querySelectorAll('pre.mermaid');
    if (!blocks.length) return;
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      flowchart: { useMaxWidth: false },
      sequence: { useMaxWidth: false },
      fontFamily: "'JetBrains Mono', ui-monospace, monospace",
      themeVariables: {
        darkMode: true,
        background: '#15161c',
        primaryColor: '#1b1d24',
        primaryBorderColor: '#363946',
        primaryTextColor: '#f4f5f8',
        lineColor: '#9a9fad',
        secondaryColor: '#1b1d24',
        tertiaryColor: '#15161c',
        mainBkg: '#1b1d24',
        nodeBorder: '#464a58',
        clusterBkg: '#15161c',
        clusterBorder: '#2a2c36',
        titleColor: '#f4f5f8',
        edgeLabelBackground: '#0e0f13',
        actorBkg: '#1b1d24',
        actorBorder: '#464a58',
        actorTextColor: '#f4f5f8',
        signalColor: '#9a9fad',
        signalTextColor: '#d0d3dc',
        noteBkgColor: '#1b1d24',
        noteTextColor: '#f4f5f8',
        noteBorderColor: '#363946',
      },
    });
    await mermaid.run({ nodes: blocks });
  }

  renderMermaid().finally(() => {
    mediumZoom('.prose img, .cover img:not([src^="/covers/"])', { margin: 24, background: 'rgba(14, 15, 19, .96)' });
  });

  // Language label and copy button on every highlighted code block.
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code')) {
    const shell = document.createElement('div');
    shell.className = 'code';
    pre.replaceWith(shell);
    const bar = document.createElement('div');
    bar.className = 'code-bar';
    const lang = document.createElement('span');
    const name = pre.dataset.language;
    lang.textContent = name && name !== 'plaintext' ? name : 'text';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy';
    btn.textContent = 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Failed';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1600);
    });
    bar.append(lang, btn);
    shell.append(bar, pre);
  }

  // Hover a section heading for a link to it; clicking copies the URL.
  for (const h of document.querySelectorAll<HTMLElement>('.prose :is(h2, h3)[id]')) {
    const a = document.createElement('a');
    a.className = 'h-link';
    a.href = `#${h.id}`;
    a.setAttribute('aria-label', `Copy link to “${h.textContent}”`);
    a.textContent = '#';
    a.addEventListener('click', async (e) => {
      e.preventDefault();
      history.replaceState(null, '', a.hash);
      h.scrollIntoView({ block: 'start' });
      try {
        await navigator.clipboard.writeText(location.href);
        a.dataset.copied = '';
        setTimeout(() => delete a.dataset.copied, 1400);
      } catch {}
    });
    h.append(a);
  }

  // Thin reading progress line across the top of the window.
  const bar = document.querySelector<HTMLElement>('.progress span');
  const article = document.querySelector<HTMLElement>('article .prose');
  if (bar && article) {
    let queued = false;
    const draw = () => {
      queued = false;
      const r = article.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(draw); } }, { passive: true });
    addEventListener('resize', draw);
    draw();
  }

  // Mark the section being read in the side rail contents.
  const links = new Map<string, HTMLAnchorElement>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.toc-rail a')) links.set(decodeURIComponent(a.hash.slice(1)), a);
  const heads = [...document.querySelectorAll<HTMLElement>('.prose :is(h2, h3)[id]')].filter((h) => links.has(h.id));
  if (heads.length) {
    let ticking = false;
    const mark = () => {
      ticking = false;
      let cur: HTMLElement | undefined;
      for (const h of heads) if (h.getBoundingClientRect().top < 120) cur = h;
      for (const a of links.values()) a.removeAttribute('aria-current');
      if (cur) links.get(cur.id)?.setAttribute('aria-current', 'true');
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(mark); } }, { passive: true });
    mark();
  }
</script>
