---
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { SITE } from '../../consts';
import { getPosts, byYear, pad } from '../../lib/posts';

const posts = await getPosts();
---
<Base title={`Writing — MindPatch`} description={SITE.blogDescription}>
  <section class="hero page">
    <div class="lbl">{pad(posts.length)} {posts.length === 1 ? 'post' : 'posts'}, newest first</div>
    <h1>Writing</h1>
  </section>
  {posts.length === 0 && <p class="empty">Nothing here yet.</p>}
  {byYear(posts).map(([year, list]) => (
    <section class="year">
      <div class="sh"><h2>{year}</h2></div>
      <ul class="entries">{list.map((p) => <Entry post={p} />)}</ul>
    </section>
  ))}
</Base>
