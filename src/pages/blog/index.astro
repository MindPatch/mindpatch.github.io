---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../consts';
import { getPosts, formatDate } from '../../lib/posts';

const posts = await getPosts();
---
<Base title={`Writing — MindPatch`} description={SITE.blogDescription}>
  <Header />
  <main class="wrap">
    <header class="page-head">
      <h1>Writing</h1>
      <p>Security research, bug hunting notes and vulnerability writeups.</p>
    </header>
    {posts.length === 0 && <p class="empty">Nothing here yet.</p>}
    <ul class="entries">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`}>
            <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
            <span class="title">{p.data.title}</span>
            <p class="desc">{p.data.description}</p>
            {p.data.tags.length > 0 && <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>}
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</Base>
